# Copy to .env (in the support-copilot root) and fill in. Never commit .env.

# --- Copilot ---
# SQLite file and the RAG index/uploads live here (relative to the project root)
DATA_DIR=data
DATABASE_URL=
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
# Signs reply drafts, e.g. TechNomad
COMPANY_NAME=

# --- LLM: openai | anthropic | none (none = every draft is escalated) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Empty = provider default (anthropic: claude-opus-5-5, openai: gpt-6-luna)
LLM_MODEL=
# OpenAI-compatible host for LLM_PROVIDER=openai; empty = api.openai.com.
# Key goes in OPENAI_API_KEY; LLM_MODEL is then required. Free presets:
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1                        LLM_MODEL=llama-3.3-70b-versatile
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_EFFORT=low
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_S=60

# --- Retrieval (passed through to rag_core) ---
INDEX_BACKEND=faiss
EMBEDDING_MODEL=intfloat/multilingual-e5-small
TOP_K=5
# Calibrated for multilingual-e5-small; re-tune for other models
MIN_SCORE=0.75
CHUNK_MAX_CHARS=500
CHUNK_OVERLAP_CHARS=100
MAX_DOCUMENTS=50
